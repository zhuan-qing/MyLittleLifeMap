# 本地开发环境变量模板。复制为 .env 后按需修改；.env 已进 .gitignore，不要提交。
# 所有变量在 docker-compose.yml 与各服务 application.yaml 里都有同名默认值，
# 因此 .env 缺失时也能启动，只是密码用默认值。

# 项目名：决定容器名前缀与数据卷前缀
COMPOSE_PROJECT_NAME=lifemap

# ---------- 镜像源 ----------
# 国内直连 Docker Hub 常被拦（403/超时），这里按实测可用的镜像站写。
# 换网络环境或换镜像站时只改这几行，compose 文件不用动。
# 如果哪天能直连 Docker Hub，把它们换回官方路径即可：
#   POSTGRES_IMAGE=postgres:18.6  REDIS_IMAGE=redis:7.4-alpine
#   MINIO_IMAGE=minio/minio:latest  MC_IMAGE=minio/mc:latest  NACOS_IMAGE=nacos/nacos-server:v2.3.2
POSTGRES_IMAGE=docker.xuanyuan.run/library/postgres:18.6
REDIS_IMAGE=redis:7.4-alpine
MINIO_IMAGE=docker.1panel.live/minio/minio:latest
MC_IMAGE=docker.1panel.live/minio/mc:latest
NACOS_IMAGE=docker.xuanyuan.run/nacos/nacos-server:v2.3.2

# ---------- PostgreSQL ----------
# 单实例三库：place_db / media_db / nacos，首次启动由 deploy/postgres/init 创建
POSTGRES_USER=lifemap
POSTGRES_PASSWORD=lifemap_dev_2026
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=lifemap_dev_2026
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=lifemap
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Nacos ----------
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
# namespace 按环境隔离，group 按服务拆分（GATEWAY / PLACE / MEDIA / STATS）
NACOS_NAMESPACE=lifemap-dev

# ---------- 业务服务（宿主直跑时读取） ----------
GATEWAY_PORT=8080
PLACE_PORT=8081
MEDIA_PORT=8082
STATS_PORT=8083

# 高德 Web 服务 Key，P1 起需要；不填则地理代理接口报错，其余功能不受影响
AMAP_WEB_KEY=
